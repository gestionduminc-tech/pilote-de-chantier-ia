# =============================================================================
# PILOTE DE CHANTIER IA - VARIABLES D'ENVIRONNEMENT
# =============================================================================
# 
# Copiez ce fichier en .env et remplissez les valeurs appropriées
# IMPORTANT : Ne committez JAMAIS le fichier .env avec des secrets réels
#
# Les variables préfixées par VITE_ sont exposées au client (frontend)
# Ne mettez JAMAIS de secrets sensibles dans ces variables
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
VITE_APP_TITLE="Pilote de Chantier IA"
VITE_APP_LOGO=""
VITE_APP_ID=""

# -----------------------------------------------------------------------------
# Analytics (Umami)
# -----------------------------------------------------------------------------
VITE_ANALYTICS_ENDPOINT="https://analytics.example.com"
VITE_ANALYTICS_WEBSITE_ID="your-website-id-here"

# -----------------------------------------------------------------------------
# OAuth / Authentication (si vous activez l'authentification)
# -----------------------------------------------------------------------------
OAUTH_SERVER_URL="https://oauth.manus.im"
VITE_OAUTH_PORTAL_URL="https://portal.manus.im"
OWNER_NAME=""
OWNER_OPEN_ID=""

# -----------------------------------------------------------------------------
# API Forge (si vous utilisez les services Manus)
# -----------------------------------------------------------------------------
BUILT_IN_FORGE_API_KEY=""
BUILT_IN_FORGE_API_URL="https://api.manus.im"
VITE_FRONTEND_FORGE_API_KEY=""
VITE_FRONTEND_FORGE_API_URL="https://api.manus.im"

# -----------------------------------------------------------------------------
# JWT (si vous utilisez l'authentification)
# -----------------------------------------------------------------------------
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Services externes (à configurer selon vos besoins)
# -----------------------------------------------------------------------------
# SENDGRID_API_KEY="your-sendgrid-api-key"
# FROM_EMAIL="contact@pilote-chantier-ia.com"
# HUBSPOT_API_KEY="your-hubspot-api-key"
